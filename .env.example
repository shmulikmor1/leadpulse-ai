# Copy this file to .env and fill in the values. Never commit .env.

# Gemini API key - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-3.1-flash-lite, then gemini-flash-lite-latest)
GEMINI_MODEL=

# Optional: Make webhook URL that receives every analysis result
AUTOMATION_WEBHOOK_URL=
