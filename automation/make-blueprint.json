      "id": 6,
      "module": "telegram:SendReplyMessage",
      "version": 1,
      "parameters": {
        "__IMTCONN__": 0
      },
      "filter": {
        "name": "דחוף",
        "conditions": [
          [
            {
              "a": "{{1.urgency}}",
              "o": "number:greaterorequal",
              "b": "4"
            }
          ]
        ]
      },
      "mapper": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "🔥 ליד דחוף (דחיפות) {{1.urgency}}\r\n\r\n{{1.summary}}\r\nהצעד הבא: {{1.nextAction}}\r\n\r\nתשובה מוצעת:\n{{1.suggestedReply}}\r\n\r\n\r\nטלפון: {{1.extracted.phone}}\r\n",
        "messageThreadId": "",
        "parseMode": "",
        "replyToMessageId": "",
        "replyMarkupAssembleType": "reply_markup_enter",
        "replyMarkup": ""
      },
